# Local exploratory backend (default port 8001)
PORT=8001
APP_ENV=local
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DuckDB file (created by scripts/seed_local_silver.py if missing)
DUCKDB_PATH=runtime/tempo_local.duckdb

# LLM — Gemini via google-genai SDK (Google AI Studio key, usually AIza…)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Or set MODEL_GEMINI in repo root .env (same as backend)

# Alternatives
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=

AGENT_MAX_STEPS=8
SQL_MAX_ROWS=200
