APP_ENV=local
CORS_ORIGINS=http://localhost:3000
DEFAULT_LLM_PROVIDER=qwen

QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=
QWEN_VERIFY_SSL=true

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
