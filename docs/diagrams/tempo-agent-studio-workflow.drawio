        <mxCell id="e-scope-out" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E94D75;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#9F1239;" edge="1" parent="1" source="scope-decision" target="out-scope"><mxGeometry relative="1" as="geometry"/></mxCell>
