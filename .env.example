# ============================================================
# Application (Backend)
# ============================================================
APP_ENV=local
PROJECT_ID=tempo_scan

# Split deployment (Milestone 7.2): set this to the deployed "Tempo Scan
# Frontend" CAI Application's public URL, comma-separated if there is more
# than one (e.g. a preview + production URL). No wildcard in production.
# Legacy single-app path (scripts/run-cai-app.sh): localhost values below
# are enough since frontend and backend share an origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# LLM (Qwen / vLLM — proven serving endpoint, consumed via env only)
# ============================================================
# mock: deterministic offline responses, no network calls (default, safe for CAI first deploy)
# remote: calls the OpenAI-compatible Qwen endpoint below
LLM_MODE=mock
QWEN_BASE_URL=https://qwen-model.ml-1ac6654a-4de.ano03-cd.a465-9q4k.cloudera.site/v1
QWEN_MODEL=Qwen3.8-27B-AWQ
QWEN_API_TOKEN=
QWEN_REQUEST_TIMEOUT_SECONDS=60
QWEN_MAX_RETRIES=1
QWEN_VERIFY_SSL=true
QWEN_DISABLE_THINKING=true
QWEN_MAX_TOKENS=1400

# ============================================================
# Data Backend
# ============================================================
# duckdb: local governed demo data, no credentials required (default for initial CAI deployment)
# trino: live CDW — requires the TRINO_* credentials below (future certification step, see docs/cloudera-ai-deployment.md)
DATA_BACKEND=duckdb
DUCKDB_PATH=runtime/tempo_scan.duckdb

TRINO_JDBC_URL=jdbc:trino://ano03-trino-demo.dw-ano03-cdp-env.a465-9q4k.cloudera.site:443
TRINO_HOST=
TRINO_PORT=443
TRINO_HTTP_SCHEME=https
TRINO_CATALOG=
TRINO_SCHEMA=
TRINO_USER=
TRINO_PASSWORD=
TRINO_ACCESS_TOKEN=
TRINO_VERIFY_SSL=true
TRINO_CONNECT_TIMEOUT_SECONDS=10
TRINO_QUERY_TIMEOUT_SECONDS=60
TRINO_MAX_ROWS=500

# Dedicated bootstrap identity. Never reuse the application TRINO_* credential.
TRINO_LOADER_JDBC_URL=jdbc:trino://ano03-trino-demo.dw-ano03-cdp-env.a465-9q4k.cloudera.site:443
TRINO_LOADER_HOST=
TRINO_LOADER_PORT=443
TRINO_LOADER_HTTP_SCHEME=https
TRINO_LOADER_CATALOG=
TRINO_LOADER_SCHEMA=
TRINO_LOADER_USER=
TRINO_LOADER_PASSWORD=
TRINO_LOADER_ACCESS_TOKEN=
TRINO_LOADER_VERIFY_SSL=true
TRINO_LOADER_CONNECT_TIMEOUT_SECONDS=10
TRINO_LOADER_QUERY_TIMEOUT_SECONDS=120
TRINO_LOADER_BATCH_SIZE=500
TRINO_LOADER_DRY_RUN=false

SQL_MAX_ROWS=500
SQL_MAX_REPAIR_ATTEMPTS=1

GUARDRAILS_ENABLED=false
TELEMETRY_DB_PATH=runtime/telemetry.sqlite

# ============================================================
# Mock External Market API (internal, governed snapshot-backed)
# ============================================================
MARKET_API_BASE_URL=http://127.0.0.1:8100

# ============================================================
# Optional External Refresh (data-refresh only, not a runtime dependency)
# ============================================================
# Serper.dev is a controlled snapshot-refresh mechanism run manually/offline
# (see scripts/fetch_market_snapshot.py). Leave SERPER_ENABLED=false for
# normal application startup — the app reads persisted snapshots instead.
SERPER_API_KEY=
SERPER_ENABLED=false
SERPER_MAX_QUERIES=5
# Legacy alias kept during migration; prefer SERPER_API_KEY.
SERPAPI_API_KEY=
SERPAPI_ENABLED=false
SERPAPI_MAX_QUERIES=5

# ============================================================
# Frontend (public-safe only — inlined into the browser bundle at build
# time, NEVER put secrets here: no Qwen token, no Serper key, no Trino
# credentials, no database credentials)
# ============================================================
# Split deployment (Milestone 7.2): the deployed "Tempo Scan Backend" CAI
# Application's public URL. Required by scripts/run-cai-frontend.sh.
# Leave unset for the legacy single-app path (scripts/run-cai-app.sh),
# where the frontend calls the backend same-origin via /api/*.
NEXT_PUBLIC_BACKEND_API_URL=
NEXT_PUBLIC_APP_NAME=Commercial Intelligence
NEXT_PUBLIC_CUSTOMER_NAME=Tempo Scan
